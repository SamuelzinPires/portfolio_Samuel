---
// Certificações: cronologia por trilhas (raias Linguagem · Dados · Conceitos), eixo ordinal por data de
// conclusão. Tudo vem da collection `certificados`; sem PDF (não são hospedados nem abertos).
// Certificado novo = uma linha nova em src/data/certificados.json.
import Cronologia from '../components/certificados/Cronologia.astro';
import Pagina from '../layouts/Pagina.astro';
import { carregarCertificados, resumir } from '../lib/certificados';

const certificados = await carregarCertificados();
const resumo = resumir(certificados);
---

<Pagina
  titulo="Certificações — Samuel Pires de Miranda"
  descricao="Certificados de Python, SQL, importação de dados, APIs, engenharia de dados e cloud que Samuel Pires de Miranda concluiu na DataCamp em 2026."
>
  <header class="cabeca-pagina">
    <p class="consulta" aria-hidden="true">
      <span class="consulta__prompt">&gt;</span>
      <span>SELECT * FROM certificados<span class="consulta__extra"> ORDER BY conclusao</span>;</span>
    </p>
    <div class="cabeca-pagina__linha">
      <div class="cabeca-pagina__texto">
        <h1 class="titulo-pagina">certificações</h1>
        <p class="lead cabeca-pagina__lead cabeca-pagina__lead--sempre">{resumo.frase}</p>
      </div>
      <dl class="numeros cabeca-pagina__numeros">
        {
          resumo.numeros.map((n) => (
            <div class="numero">
              <dt class="numero__rotulo">{n.rotulo}</dt>
              <dd class="numero__valor">{n.valor}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </header>

  <Cronologia certificados={certificados} />
</Pagina>

<script>
  import '../scripts/certificados';
</script>
