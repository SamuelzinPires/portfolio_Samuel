---
// Certificações (modelo C3): por ano e, dentro do ano, por mês, o mais recente primeiro. Tudo vem da collection
// `certificados`; sem PDF (não são hospedados nem abertos). Certificado novo = uma linha nova em
// src/data/certificados.json.
import Certificados from '../components/certificados/Certificados.astro';
import TextoSeta from '../components/TextoSeta.astro';
import Pagina from '../layouts/Pagina.astro';
import { carregarCertificados, contarCertificados, resumir } from '../lib/certificados';

const certificados = await carregarCertificados();
const resumo = resumir(certificados);
---

<Pagina
  titulo="Certificações — Samuel Pires de Miranda"
  descricao="Certificados de Python, SQL, importação de dados, APIs, engenharia de dados e cloud que Samuel Pires de Miranda concluiu na DataCamp em 2026."
>
  <header class="cabeca-pagina">
    {
      resumo.linha && (
        <p class="linha-resumo" aria-hidden="true">
          &gt; <TextoSeta texto={resumo.linha} />
        </p>
      )
    }
    <div class="cabeca-pagina__linha">
      <h1 class="titulo-pagina">certificações</h1>
      <p class="lead cabeca-pagina__lead cabeca-pagina__lead--sempre cabeca-pagina__lead--lado">{resumo.frase}</p>
    </div>
  </header>

  <Certificados certificados={certificados} />
  {certificados.length > 0 && <p class="fim-lista">fim da lista · {contarCertificados(certificados.length)}</p>}
</Pagina>

<script>
  import '../scripts/certificados';
</script>
