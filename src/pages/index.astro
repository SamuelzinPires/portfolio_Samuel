---
import Base from '../layouts/Base.astro';

const nome = 'Samuel Pires de Miranda';
const titulo = 'Engenheiro de Dados Júnior';
---

<Base
  titulo={`${nome} — ${titulo}`}
  descricao="Portfólio de Samuel Pires de Miranda, engenheiro de dados júnior em Goiânia/GO. Site em construção."
>
  <main id="conteudo">
    <p class="selo">// em construção</p>
    <h1>{nome}</h1>
    <p class="titulo">{titulo}</p>
    <p class="aviso">Meu portfólio está sendo construído. Volte em breve.</p>
  </main>
</Base>

<style>
  main {
    min-height: 100vh;
    display: grid;
    align-content: center;
    max-width: 60rem;
    margin-inline: auto;
    padding: var(--margem-pagina);
  }

  .selo {
    color: var(--cor-azul-claro);
    margin-bottom: var(--esp-4);
  }

  h1 {
    font-size: var(--texto-titulo);
  }

  .titulo {
    margin: var(--esp-2) 0 var(--esp-5);
    color: var(--cor-azul-claro);
    font-size: var(--texto-lead);
  }

  .aviso {
    color: var(--cor-apagado);
  }
</style>
