---
const nome = 'Samuel Pires de Miranda';
const titulo = 'Engenheiro de Dados Júnior';
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{nome} — {titulo}</title>
    <meta
      name="description"
      content="Portfólio de Samuel Pires de Miranda, engenheiro de dados júnior em Goiânia/GO. Site em construção."
    />
  </head>
  <body>
    <main>
      <p class="selo">// em construção</p>
      <h1>{nome}</h1>
      <p class="titulo">{titulo}</p>
      <p class="aviso">Meu portfólio está sendo construído. Volte em breve.</p>
    </main>
  </body>
</html>

<style is:global>
  :root {
    --bg: #0d1117;
    --accent: #1f6feb;
    --text: #e6edf3;
    --muted: #8b949e;
  }

  * {
    box-sizing: border-box;
  }

  body {
    margin: 0;
    min-height: 100vh;
    display: grid;
    place-items: center;
    padding: 1.5rem;
    background: var(--bg);
    color: var(--text);
    font-family: ui-monospace, 'Cascadia Code', Consolas, monospace;
  }

  main {
    max-width: 40rem;
  }

  .selo {
    color: var(--accent);
    margin: 0 0 1rem;
  }

  h1 {
    margin: 0;
    font-size: clamp(1.8rem, 6vw, 3rem);
    line-height: 1.1;
  }

  .titulo {
    margin: 0.5rem 0 1.5rem;
    color: var(--accent);
    font-size: 1.25rem;
  }

  .aviso {
    margin: 0;
    color: var(--muted);
  }
</style>
