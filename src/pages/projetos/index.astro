---
// Lista de projetos (modelo P4): por mês de início, do mais recente ao mais antigo, tudo lido da collection no build.
// Sem o alternador "mapa | lista": o mapa só existe na V2 (Parte 4).
import ListaProjetos from '../../components/projetos/ListaProjetos.astro';
import TextoSeta from '../../components/TextoSeta.astro';
import Pagina from '../../layouts/Pagina.astro';
import { carregarProjetos, contarProjetos, resumirProjetos } from '../../lib/projetos';

const projetos = (await carregarProjetos()).reverse();
const total = projetos.length;
const linha = resumirProjetos(projetos);
---

<Pagina
  titulo="Projetos — Samuel Pires de Miranda"
  descricao="Pipelines, APIs e análises de dados que Samuel Pires de Miranda construiu em 2026. Cada cartão abre o estudo de caso do projeto."
>
  <header class="cabeca-pagina cabeca-pagina--lista">
    {
      linha && (
        <p class="linha-resumo" aria-hidden="true">
          &gt; <TextoSeta texto={linha} />
        </p>
      )
    }
    <div class="cabeca-pagina__linha">
      <h1 class="titulo-pagina">projetos</h1>
      <p class="lead cabeca-pagina__lead cabeca-pagina__lead--sempre cabeca-pagina__lead--lado">
        Do mais recente (em azul) para o mais antigo. Os cartões maiores (<span class="sr-only">com estrela</span><span
          aria-hidden="true">★</span
        >) são os destaques.
      </p>
    </div>
  </header>

  <ListaProjetos projetos={projetos} />
  {total > 0 && <p class="fim-lista">fim da lista · {total} de {contarProjetos(total)}</p>}
</Pagina>
