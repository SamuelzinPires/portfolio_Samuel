---
// Contato (K3): uma DAG de 3 tarefas, você → canal → Samuel. E-mail com "escrever" (mailto) e "copiar";
// LinkedIn e GitHub abrem em outra aba. Sem formulário, sem telefone e sem cookies.
import ContatoDag from '../components/contato/ContatoDag.astro';
import Pagina from '../layouts/Pagina.astro';
---

<Pagina
  titulo="Contato — Samuel Pires de Miranda"
  descricao="Fale com Samuel Pires de Miranda, engenheiro de dados júnior em Goiânia/GO: e-mail, LinkedIn e GitHub."
>
  <header class="cabeca-pagina">
    <p class="consulta" aria-hidden="true">
      <span class="consulta__prompt">&gt;</span>
      <span>SELECT canal, endereco FROM contatos;</span>
    </p>
    <h1 class="titulo-pagina">contato</h1>
    <p class="lead cabeca-pagina__lead cabeca-pagina__lead--sempre">
      Escolha um canal: o caminho acende e a mensagem chega até mim.{' '}<span class="lead__extra"
        >É uma DAG de 3 tarefas, disparada manualmente pelo seu clique.</span
      >
    </p>
  </header>

  <ContatoDag />
</Pagina>

<script>
  import '../scripts/contato';
</script>
