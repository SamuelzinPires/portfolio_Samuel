---
// Cartão de compartilhamento (Open Graph, 1200 × 630) de cada projeto e o padrão do site.
// SÓ EXISTE NO `npm run dev`: no build esta rota não gera página nenhuma. O `npm run og` abre cada cartão
// no Chrome e salva o print em public/og/<slug>.png, que é o que o LinkedIn e o WhatsApp mostram.
import '@fontsource-variable/jetbrains-mono';
import '../../styles/tokens.css';
import { site } from '../../data/site';
import { periodo } from '../../lib/datas';
import { carregarProjetos, resumirStack, type Projeto } from '../../lib/projetos';

export async function getStaticPaths() {
  if (!import.meta.env.DEV) return [];
  const projetos = await carregarProjetos();
  return [
    { params: { slug: 'padrao' }, props: { projeto: undefined } },
    ...projetos.map((projeto) => ({ params: { slug: projeto.id }, props: { projeto } })),
  ];
}

interface Props {
  projeto?: Projeto;
}

const { projeto } = Astro.props;
const d = projeto?.data;
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Cartão OG · {d?.titulo ?? 'padrão'}</title>
  </head>
  <body>
    <div class="cartao">
      <p class="cartao__prompt">
        <span class="cartao__usuario">samuel@dados</span>:~{projeto ? `/projetos/${projeto.id}` : ''}$
      </p>

      {
        projeto && d ? (
          <div class="cartao__miolo">
            <h1 class="cartao__titulo">{d.titulo}</h1>
            <p class="cartao__texto">{d.resumo}</p>
          </div>
        ) : (
          <div class="cartao__miolo">
            <h1 class="cartao__titulo cartao__titulo--nome">
              {site.nome}<span class="cartao__cursor"></span>
            </h1>
            <p class="cartao__cargo">&gt; {site.titulo}</p>
            <p class="cartao__texto">{site.resumo}</p>
          </div>
        )
      }

      <div class="cartao__rodape">
        {
          projeto && d?.numeros?.length ? (
            <dl class="cartao__numeros">
              {d.numeros.map((n) => (
                <div>
                  <dt class="cartao__rotulo">{n.rotulo}</dt>
                  <dd class:list={['cartao__valor', n.tom && `cartao__valor--${n.tom}`]}>{n.valor}</dd>
                </div>
              ))}
            </dl>
          ) : projeto && d ? (
            <p class="cartao__rotulo">
              {resumirStack(d.stack, 4)} · {periodo(d.inicio, d.fim, 'em andamento')}
            </p>
          ) : (
            <p class="cartao__rotulo">{site.local}</p>
          )
        }
        <p class="cartao__assinatura">{projeto ? `${projeto.numero} · ${site.nome}` : 'portfólio'}</p>
      </div>
    </div>
  </body>
</html>

<style is:global>
  html,
  body {
    margin: 0;
    width: 1200px;
    height: 630px;
    overflow: hidden;
    background: var(--cor-fundo);
    color: var(--cor-texto);
    font-family: var(--fonte-mono);
    font-variant-ligatures: none;
  }

  .cartao {
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    width: 1200px;
    height: 630px;
    padding: 56px 64px;
    border-top: 6px solid var(--cor-azul);
  }

  .cartao__prompt {
    margin: 0;
    font-size: 22px;
    color: var(--cor-apagado);
  }

  .cartao__usuario {
    color: var(--cor-ok);
  }

  .cartao__miolo {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .cartao__titulo {
    margin: 0;
    max-width: 17ch;
    font-size: 76px;
    font-weight: 800;
    line-height: 1.05;
    letter-spacing: -0.035em;
  }

  .cartao__titulo--nome {
    max-width: 14ch;
  }

  .cartao__cursor {
    display: inline-block;
    width: 0.5em;
    height: 0.9em;
    margin-left: 0.1em;
    vertical-align: -0.08em;
    background: var(--cor-azul);
  }

  .cartao__cargo {
    margin: 0;
    font-size: 32px;
    font-weight: 600;
    color: var(--cor-azul-claro);
  }

  .cartao__texto {
    margin: 0;
    max-width: 1000px;
    font-size: 24px;
    line-height: 1.45;
    color: var(--cor-apagado);
  }

  .cartao__rodape {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 32px;
  }

  .cartao__numeros {
    display: flex;
    gap: 56px;
    margin: 0;
  }

  .cartao__numeros > div {
    display: flex;
    flex-direction: column-reverse;
    justify-content: flex-end; /* em column-reverse, "fim" é o topo: os números alinham em cima */
    gap: 8px;
  }

  .cartao__numeros dd {
    margin: 0;
  }

  .cartao__valor {
    font-size: 56px;
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.03em;
  }

  .cartao__valor--ok {
    color: var(--cor-ok);
  }

  .cartao__valor--falha {
    color: var(--cor-falha);
  }

  .cartao__rotulo {
    margin: 0;
    max-width: 320px;
    font-size: 20px;
    line-height: 1.35;
    color: var(--cor-apagado);
  }

  .cartao__assinatura {
    flex: none;
    margin: 0;
    white-space: nowrap;
    font-size: 20px;
    color: var(--cor-apagado);
    text-align: right;
  }
</style>
