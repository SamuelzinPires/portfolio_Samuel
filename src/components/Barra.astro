---
// Barra de topo: o prompt (link para a home) e o menu. O item da página atual leva aria-current.
const caminho = Astro.url.pathname.replace(/\/+$/, '') || '/';
const [, secao = '', subpagina = ''] = caminho.split('/');
const pasta = secao ? `~/${secao}` : '~';

const itens = [
  { href: '/projetos', rotulo: './projetos' },
  { href: '/certificacoes', rotulo: './certificações' },
  { href: '/contato', rotulo: './contato' },
];
const atual = (href: string) => caminho === href || caminho.startsWith(`${href}/`);
---

<header class="barra">
  <a class="barra__prompt" href="/" aria-label="Samuel Pires de Miranda, página inicial">
    <span class="barra__usuario">samuel@dados</span>:{pasta}{subpagina && <span class="barra__sub">/{subpagina}</span>}$
  </a>
  <nav aria-label="Principal">
    <ul class="barra__nav" role="list">
      {
        itens.map((item) => (
          <li>
            <a class="barra__link" href={item.href} aria-current={atual(item.href) ? 'page' : undefined}>
              {item.rotulo}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>
