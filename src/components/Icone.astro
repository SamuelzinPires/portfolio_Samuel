---
// Ícones em SVG: a fonte hospedada (JetBrains Mono latina) não tem → ↗ ★.
interface Props {
  nome: 'seta' | 'externo' | 'estrela';
  class?: string;
}

const { nome, class: classe } = Astro.props;
---

{
  nome === 'seta' && (
    <svg class:list={['icone', classe]} viewBox="0 0 16 16" aria-hidden="true">
      <path d="M2 8h11M9 4l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.5" />
    </svg>
  )
}
{
  nome === 'externo' && (
    <svg class:list={['icone', classe]} viewBox="0 0 16 16" aria-hidden="true">
      <path d="M5 11l6-6M6 5h5v5" fill="none" stroke="currentColor" stroke-width="1.5" />
    </svg>
  )
}
{
  nome === 'estrela' && (
    <svg class:list={['estrela', classe]} viewBox="0 0 16 16" aria-hidden="true">
      <path d="M8 1.5l1.9 4.1 4.5.5-3.4 3 1 4.4L8 11.2l-4 2.3 1-4.4-3.4-3 4.5-.5z" fill="currentColor" />
    </svg>
  )
}
