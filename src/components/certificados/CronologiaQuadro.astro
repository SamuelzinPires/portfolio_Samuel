---
// Cronologia dos certificados no desktop (a partir de 1024 px): raias por trilha, eixo ordinal por data de
// conclusão, um certificado por coluna e uma linha ligando os certificados da mesma raia.
// Sem JavaScript ele já vem completo; o script (certificados.ts) só filtra e recolhe quando há muitos.
// O mesmo cálculo de ligações roda aqui e no script (src/lib/cronologia.ts).
import { ligacoes } from '../../lib/cronologia';
import { chaveDoMes, type Certificado, type Raia } from '../../lib/certificados';
import { isoDia, mesAno } from '../../lib/datas';
import Icone from '../Icone.astro';

interface Props {
  certificados: Certificado[];
  raias: Raia[];
  /** Mais de um mês nos dados: o eixo ganha o cabeçalho de cada mês. */
  variosMeses: boolean;
}

const { certificados, raias, variosMeses } = Astro.props;

// nos[r] = colunas que têm certificado na raia r
const nos = raias.map((r) => r.certificados.map((c) => c.coluna));
---

<div class="quadro-cronologia" data-quadro>
  <div
    class="quadro-cronologia__rolagem"
    data-rolagem
    tabindex="0"
    role="region"
    aria-label="Cronologia dos certificados: role para o lado para ver todos"
  >
    <div class="quadro-cronologia__corpo">
      {
        raias.map((raia, r) => (
          <div class="raia" data-raia={raia.id} data-grupo>
            <div class="raia__rotulo">
              <h2 class="raia-titulo">
                {raia.numero} · {raia.nome}
                <small>{raia.assunto}</small>
              </h2>
              <button type="button" class="ver-todos" data-ver-todos hidden>
                ver todos ({raia.certificados.length})
              </button>
            </div>
            <ol class="raia__nos" role="list">
              {certificados.map((c) => {
                const meu = c.trilha === raia.id;
                const lig = ligacoes(nos, r, c.coluna);
                return (
                  <li
                    class:list={[
                      'celula',
                      meu ? 'celula--no' : 'celula--vazia',
                      lig.esq && 'celula--esq',
                      lig.dir && 'celula--dir',
                      lig.prumo && 'celula--prumo',
                    ]}
                    data-col={c.coluna}
                    data-cert={meu ? c.id : undefined}
                    data-trilha={meu ? c.trilha : undefined}
                    data-emissor={meu ? c.emissor : undefined}
                    aria-hidden={meu ? undefined : 'true'}
                  >
                    {meu && (
                      <article class="no-certificado">
                        <p class="no-certificado__meta">
                          {c.emissor} · <time datetime={isoDia(c.conclusao)}>{c.rotulo}</time>
                        </p>
                        <h3 class="no-certificado__titulo">{c.titulo}</h3>
                        {c.urlVerificacao && (
                          <a class="link-externo" href={c.urlVerificacao} target="_blank" rel="noopener noreferrer">
                            verificar
                            <Icone nome="externo" />
                            <span class="sr-only">(abre em nova aba)</span>
                          </a>
                        )}
                      </article>
                    )}
                  </li>
                );
              })}
            </ol>
          </div>
        ))
      }
      <div class="eixo" aria-hidden="true">
        <p class="eixo__rotulo">
          conclusão
          <Icone nome="seta" class="icone--texto" />
        </p>
        <ol class="eixo__pontos" role="list">
          {
            certificados.map((c, i) => (
              <li
                class:list={[
                  'eixo__ponto',
                  variosMeses && (i === 0 || chaveDoMes(certificados[i - 1]) !== chaveDoMes(c)) && 'eixo__ponto--mes',
                ]}
                data-col={c.coluna}
                data-mes={chaveDoMes(c)}
              >
                <span class="eixo__data">{c.rotulo}</span>
                <span class="eixo__mes">{mesAno(c.conclusao)}</span>
              </li>
            ))
          }
        </ol>
      </div>
    </div>
  </div>
  <p class="dica-rolagem" data-dica hidden>role para o lado: os mais recentes estão à direita</p>
</div>
