---
import { site } from '../data/site';
import Icone from './Icone.astro';
import LinkEmail from './LinkEmail.astro';
---

<footer class="rodape">
  <span>{site.local}</span>
  <ul class="rodape__links" role="list">
    <li><LinkEmail>e-mail</LinkEmail></li>
    <li>
      <a href={site.linkedin} target="_blank" rel="noopener noreferrer">
        LinkedIn<Icone nome="externo" /><span class="sr-only">(abre em nova aba)</span>
      </a>
    </li>
    <li>
      <a href={site.github} target="_blank" rel="noopener noreferrer">
        GitHub<Icone nome="externo" /><span class="sr-only">(abre em nova aba)</span>
      </a>
    </li>
  </ul>
</footer>
